---
// index.hbs for page 2+ of the "/" (English) and "/ko/" (Korean) collections
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { getPosts, paginate } from '../lib/posts';
import { collectionSeo } from '../lib/seo';
import { langPrefix, type Lang } from '../lib/i18n';

interface Props {
    lang: Lang;
    page: number;
}
const { lang, page } = Astro.props;
const { items, pages } = paginate(await getPosts({ lang }), page);
const base = langPrefix(lang);
const seo = {
    ...collectionSeo(page),
    prev: page > 2 ? `${base}/page/${page - 1}/` : `${base}/`,
    next: page < pages ? `${base}/page/${page + 1}/` : undefined,
};
---

<Base bodyClass="paged" seo={seo} lang={lang}>
    <main class="gh-main">
        <PostList posts={items} lang={lang} moreHref={seo.next} />
    </main>
</Base>
