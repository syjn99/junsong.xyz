---
// /tag/<slug>/ and /tag/<slug>/page/<n>/: English posts with the tag
import ArchivePage from '../../components/ArchivePage.astro';
import { archiveSeo } from '../../lib/seo';
import { tagRoutes, type TagRouteProps } from '../../lib/tag-routes';
import { tagUrl } from '../../lib/i18n';

export const getStaticPaths = () => tagRoutes('en');

const { tag, page, pages, posts, other } = Astro.props as TagRouteProps;
---

<ArchivePage
    kind="tag"
    slug={tag.slug}
    name={tag.name}
    description={tag.description}
    featureImage={tag.feature_image}
    posts={posts}
    page={page}
    pages={pages}
    base={tagUrl(tag.slug, 'en')}
    lang="en"
    alternates={other ? { ko: other } : undefined}
    seo={archiveSeo(tag.name, page, { coverImage: true })}
/>
