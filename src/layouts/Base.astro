---
// default.hbs + the parts of {{ghost_head}} / {{ghost_foot}} that still apply.
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Search from '../components/Search.astro';
import '../styles/dark-mode.css';
import { site } from '../site.config';
import { absoluteUrl } from '../lib/ghost';
import { homeUrl, langs, type Alternates, type Lang } from '../lib/i18n';

export interface Seo {
    title: string;
    description?: string;
    type?: 'website' | 'article' | 'profile';
    image?: string;
    imageWidth?: number;
    imageHeight?: number;
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
    author?: boolean;
    jsonLd?: Record<string, unknown>;
    prev?: string;
    next?: string;
    noindex?: boolean;
}

interface Props {
    bodyClass: string;
    seo: Seo;
    lightbox?: boolean;
    // Language of the page; omitted for pages that exist only once (About, author, 404).
    lang?: Lang;
    // Targets of the EN/KO switch; defaults to the two home pages.
    alternates?: Partial<Alternates>;
    // True when `alternates` points at a translation of this page (adds hreflang links).
    translated?: boolean;
}
const { bodyClass, seo, lightbox = false, lang, translated = false } = Astro.props;
const alternates: Alternates = {
    en: homeUrl('en'),
    ko: homeUrl('ko'),
    ...(lang && { [lang]: Astro.url.pathname }),
    ...Astro.props.alternates,
};
const canonical = absoluteUrl(Astro.url.pathname);
const image = seo.image ? absoluteUrl(seo.image) : undefined;
---

<!doctype html>
<html lang={lang ?? site.locale} data-lang={lang}>
    <head>
        <title>{seo.title}</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="preload" as="style" href="/assets/built/screen.css" />
        <link rel="preload" as="script" href="/assets/built/source.js" />
        <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/inter-roman.woff2" crossorigin="anonymous" />
        <style is:inline>
            @font-face {
                font-family: "Inter";
                font-style: normal;
                font-weight: 100 900;
                font-display: optional;
                src: url(/assets/fonts/inter-roman.woff2) format("woff2");
                unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
            }
        </style>
        <link rel="stylesheet" type="text/css" href="/assets/built/screen.css" />
        <style
            is:inline
            set:html={`:root { --background-color: ${site.theme.siteBackgroundColor} }
:root[data-theme="dark"] { --background-color: ${site.theme.darkBackgroundColor} }`}
        />
        <script is:inline>
            /* Light or dark: the visitor's saved choice, otherwise the OS setting.
               Source's `has-light-text` class switches the theme's colour variables
               for a dark background; dark-mode.css covers what it doesn't. */
            (function () {
                var root = document.documentElement;
                var media = window.matchMedia('(prefers-color-scheme: dark)');
                function saved() {
                    try {
                        return localStorage.getItem('theme');
                    } catch (e) {
                        return null;
                    }
                }
                window.applyTheme = function (theme) {
                    root.dataset.theme = theme;
                    root.classList.toggle('has-light-text', theme === 'dark');
                    root.classList.toggle('has-dark-text', theme !== 'dark');
                    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
                        btn.setAttribute('aria-pressed', String(theme === 'dark'));
                    });
                    document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
                };
                applyTheme(saved() || (media.matches ? 'dark' : 'light'));
                media.addEventListener('change', function (e) {
                    if (!saved()) applyTheme(e.matches ? 'dark' : 'light');
                });
            })();
        </script>

        {seo.description && <meta name="description" content={seo.description} />}
        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        {seo.noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
        {
            translated &&
                !seo.noindex &&
                langs.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l])} />)
        }
        <script is:inline>
            /* Remember the language the visitor reads in, and apply it on pages
               that have no language of their own. */
            (function () {
                var root = document.documentElement;
                var key = 'lang';
                try {
                    if (root.dataset.lang) localStorage.setItem(key, root.dataset.lang);
                    else if (localStorage.getItem(key) === 'ko') root.dataset.langPref = 'ko';
                } catch (e) {}
                document.addEventListener('DOMContentLoaded', function () {
                    if (root.dataset.langPref === 'ko') {
                        document.querySelectorAll('[data-href-ko]').forEach(function (a) {
                            a.setAttribute('href', a.dataset.hrefKo);
                        });
                        document.querySelectorAll('.gh-lang-switch a').forEach(function (a) {
                            a.classList.toggle('is-active', a.dataset.lang === 'ko');
                        });
                    }
                    document.querySelectorAll('.gh-lang-switch a').forEach(function (a) {
                        a.addEventListener('click', function () {
                            try {
                                localStorage.setItem(key, a.dataset.lang);
                            } catch (e) {}
                        });
                    });
                });
            })();
        </script>
        {seo.prev && <link rel="prev" href={absoluteUrl(seo.prev)} />}
        {seo.next && <link rel="next" href={absoluteUrl(seo.next)} />}
        <meta name="referrer" content="no-referrer-when-downgrade" />

        <meta property="og:site_name" content={site.title} />
        <meta property="og:type" content={seo.type ?? 'website'} />
        <meta property="og:title" content={seo.title} />
        {seo.description && <meta property="og:description" content={seo.description} />}
        {!seo.noindex && <meta property="og:url" content={canonical} />}
        {image && <meta property="og:image" content={image} />}
        {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime.toISOString()} />}
        {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime.toISOString()} />}
        {seo.tags?.map((t) => <meta property="article:tag" content={t} />)}

        <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={seo.title} />
        {seo.description && <meta name="twitter:description" content={seo.description} />}
        {!seo.noindex && <meta name="twitter:url" content={canonical} />}
        {image && <meta name="twitter:image" content={image} />}
        {
            seo.author && (
                <>
                    <meta name="twitter:label1" content="Written by" />
                    <meta name="twitter:data1" content={site.author.name} />
                </>
            )
        }
        {
            seo.tags?.length ? (
                <>
                    <meta name="twitter:label2" content="Filed under" />
                    <meta name="twitter:data2" content={seo.tags.join(', ')} />
                </>
            ) : null
        }
        <meta name="twitter:site" content={site.twitter} />
        {seo.author && <meta name="twitter:creator" content={site.author.twitter} />}
        {seo.imageWidth && <meta property="og:image:width" content={String(seo.imageWidth)} />}
        {seo.imageHeight && <meta property="og:image:height" content={String(seo.imageHeight)} />}
        {seo.jsonLd && <script type="application/ld+json" set:html={JSON.stringify(seo.jsonLd, null, 4)} />}

        <link rel="sitemap" href="/sitemap.xml" />
        <script defer src="/public/cards.min.js"></script>
        <style
            is:inline
            set:html={`:root {--ghost-accent-color: ${site.accentColor};}
:root[data-theme="dark"] {--ghost-accent-color: ${site.darkAccentColor};}`}
        />
        <link rel="stylesheet" type="text/css" href="/public/cards.min.css" />
    </head>
    <body class={`${bodyClass} has-sans-title has-sans-body`}>
        <div class="gh-viewport">
            <Navigation lang={lang} alternates={alternates} />
            <slot />
            <Footer />
        </div>

        {lightbox && <Lightbox />}
        <Search />

        <script is:inline src="/assets/built/source.js"></script>
        {
            site.footerScripts.map((s) => (
                <script is:inline src={s.src} integrity={s.integrity} crossorigin="anonymous" referrerpolicy="no-referrer" />
            ))
        }
    </body>
</html>
